#!/bin/sh

case " $(cat /proc/cmdline) " in
	*" keystone.autorun=1 "*) ;;
	*) exit 0 ;;
esac

echo "[KEYSTONE-AUTORUN] loading keystone-driver"
if ! modprobe keystone-driver; then
	echo "[KEYSTONE-AUTORUN] failed to load keystone-driver"
	exit 1
fi

echo "[KEYSTONE-AUTORUN] running hello.ke on CPU 1"
taskset -c 1 /usr/share/keystone/examples/hello.ke
status=$?
echo "[KEYSTONE-AUTORUN] hello.ke exited with status $status"
exit "$status"
